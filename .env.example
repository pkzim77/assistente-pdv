# Painel local; o servidor continua escutando somente em 127.0.0.1.
PORT=4318
# Opcional: deixe em branco para detectar Node/Python instalados no Windows.
NODE_EXE=
PDV_PYTHON=

# Instalação local do PDV. Ajuste PDV_EXE para o executável deste estabelecimento.
PDV_EXE=C:/Program Files (x86)/arpa/control/pdv.exe
# Se o nome do processo não for o mesmo nome do executável, informe-o aqui.
PDV_PROCESS_NAME=pdv.exe
# Identificação das janelas do PDV (normalmente igual em instalações da mesma versão).
PDV_WINDOW_TITLE=PDV-FISCAL
PDV_WINDOW_CLASS=TFVendas
PDV_LOGIN_TITLE=CUPOM FISCAL
PDV_CLOSING_TITLE=FECHAMENTO DE VENDA
PDV_CLOSING_CLASS=TFecha_Venda
PDV_AUX_WINDOW_CLASSES=TFSplashScreen,TParentForm
PDV_OTHER_WINDOW_TITLES=PDV - CONTROL

# Conexão somente leitura ao banco do Arpa.
ARPA_HOST=127.0.0.1
ARPA_PORT=5432
ARPA_DATABASE=control
ARPA_USER=postgres
ARPA_SCHEMA=public
ARPA_CONNECTION_TIMEOUT_MS=2000
ARPA_QUERY_TIMEOUT_MS=5000
# Use uma conta somente leitura em producao. Nao salvar senhas no repositorio.
# ARPA_PASSWORD=

# Onde gravar eventos locais. Relativo à pasta do projeto ou caminho absoluto.
ROBOT_DATA_DIR=data
# Historico PostgreSQL separado, opcional. Nunca apontar para control.
# ROBOT_DATABASE_URL=postgresql://usuario:senha@localhost:5432/pdv_robo
